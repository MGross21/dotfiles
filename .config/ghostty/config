font-family = monospace Regular
font-size = 11

shell-integration = zsh

theme = Tomorrow Night Burns
# Optional Override Config File
config-file = ?/etc/ghostty-theme.conf

# hyprglass draws the substrate but cannot supply text contrast: its
# adaptive_dim is gated on backdrop luminance and evaluates to ~0 on this
# wallpaper, so the cell background carries it.
background-opacity = 0.35
# hyprglass sets `noblur` on every window it glasses (manage_window_blur), so
# this request is overridden anyway.
background-blur = false

window-padding-x = 5
window-padding-y = 5
window-padding-balance = true

link-previews = true
desktop-notifications = false

title = terminal
gtk-quick-terminal-namespace = terminal
term=ghostty

window-decoration = auto
window-theme = auto

# Launch Parameters
gtk-single-instance = true

# Behaviors
quit-after-last-window-closed = false
clipboard-paste-protection=true

# MacOS
macos-icon=glass
macos-window-buttons=hidden
macos-titlebar-style=transparent
macos-titlebar-proxy-icon=hidden
macos-auto-secure-input=true
macos-secure-input-indication=true
quick-terminal-screen=mouse